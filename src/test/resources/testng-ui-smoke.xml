<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.1.dtd">
<suite name="UI Smoke test suite">
    <listeners>
        <listener class-name="com.epam.reportportal.testng.ReportPortalTestNGListener"/>
        <listener class-name="listener.CustomListener"/>
    </listeners>
    <test name="UI Smoke test suite">
        <groups>
            <run>
                <include name="smoke" />
            </run>
        </groups>
        <classes>
            <class name="tests.ui.ArticleHandlingUiTests" />
            <class name="tests.ui.SearchByTagUiTests" />
            <class name="tests.ui.SignInUiTests" />
            <class name="tests.ui.UserFollowingUiTests" />
        </classes>
    </test>
</suite>