<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.1.dtd">
<suite name="API Regression test suite">
    <listeners>
        <listener class-name="com.epam.reportportal.testng.ReportPortalTestNGListener"/>
        <listener class-name="listener.CustomListener"/>
    </listeners>
    <test name="API Regression test suite">
        <groups>
            <run>
                <include name="regression" />
            </run>
        </groups>
        <classes>
            <class name="tests.api.ArticleHandlingApiTests" />
            <class name="tests.api.SearchByTagApiTests" />
            <class name="tests.api.SignInApiTests" />
            <class name="tests.api.UserFollowingApiTests" />
        </classes>
    </test>
</suite>